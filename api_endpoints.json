        ],
        "POST": {
          "id": "integer",
          "patient": "uuid",
          "patient_username": "string",
          "last_menstrual_period_date": "date",
          "estimated_due_date": "date",
          "blood_group": "string",
          "medical_history_notes": "string"
        }
      }
    },
    {
