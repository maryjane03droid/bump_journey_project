      "access": "authenticated",
      "allowed_roles": ["PATIENT", "STAFF", "ADMIN"],
      "request_body": {
        "PUT": {
          "patient": "uuid",
          "last_menstrual_period_date": "date",
          "blood_group": "string",
          "medical_history_notes": "string (optional)"
        },
        "PATCH": {
          "patient": "uuid (optional)",
          "last_menstrual_period_date": "date (optional)",
          "blood_group": "string (optional)",
          "medical_history_notes": "string (optional)"
